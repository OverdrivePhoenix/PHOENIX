# PHOENIX Environment Configuration Template
# Duplicate this file to .env and configure your keys

# 1. AI Reasoning & Agents SDK
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 2. Google Cloud Firestore
GCP_PROJECT_ID=phoenix-ai-org
FIRESTORE_EMULATOR_HOST=localhost:8080

# 3. Security & Policy Engine
POLICY_SECRET_KEY=generate_a_secure_hmac_secret_key_here

# 4. J.A.R.V.I.S. Voice Engine (Iron Man Butler Persona)
JARVIS_VOICE_NAME=Brian
JARVIS_SALUTATION=Sir
JARVIS_QUIET_HOURS_START=22:00
JARVIS_QUIET_HOURS_END=08:00
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_PHONE_NUMBER=

# Optional: ElevenLabs / OpenAI TTS Keys
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# 5. Infrastructure & Networking
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,tauri://localhost
DAILY_BUDGET_LIMIT=50.00
